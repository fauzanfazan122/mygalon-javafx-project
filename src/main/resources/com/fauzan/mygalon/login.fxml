<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>

<!--font-->
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.fauzan.mygalon.controller.LoginController"
      alignment="CENTER"
      prefWidth="1000"
      prefHeight="650">

    <!-- Kiri -->
    <VBox alignment="CENTER"
          HBox.hgrow="ALWAYS"
          maxWidth="Infinity"
          styleClass="left-panel">

        <VBox styleClass="login-form"
              alignment="CENTER_LEFT"
              spacing="24"
              maxWidth="320">

            <VBox spacing="8">
                <Label text="Login Sebagai Admin"
                       styleClass="form-title"/>

                <Label text="Selamat datang kembali"
                       styleClass="form-description"/>
            </VBox>

            <!-- username -->
            <VBox spacing="8">
                <Label>
                    <text>
                        Username
                    </text>
                    <graphic>
                        <FontIcon iconLiteral="fas-user" />
                    </graphic>
                </Label>

                <TextField fx:id="inputName" styleClass="form-input"
                           promptText="Masukkan username"/>

            </VBox>

            <!-- Password -->
            <VBox spacing="8">
                <Label>
                    <text>
                        Password
                    </text>
                    <graphic>
                        <FontIcon iconLiteral="fas-key"/>
                    </graphic>
                </Label>
                <PasswordField fx:id="inputPass" styleClass="form-input"
                               promptText="Masukkan password"/>
            </VBox>

            <Button text="Login"
                    maxWidth="Infinity"
                    onAction="#validasiLogin"
                    styleClass="btn-login"/>

            <VBox alignment="CENTER">
                <Label fx:id="loginStatus" styleClass="login-status"/>
            </VBox>

        </VBox>

    </VBox>

    <!-- Kanan -->
    <VBox alignment="CENTER"
          spacing="16"
          HBox.hgrow="ALWAYS"
          maxWidth="Infinity"
          styleClass="right-panel">

        <Label text="Selamat Datang!"
               styleClass="logo-text"/>

        <!-- Logo -->
        <StackPane prefWidth="120"
                   styleClass="logo"
                   prefHeight="120"
                   maxWidth="120"
                   maxHeight="120">
            <ImageView fitWidth="120"
                       fitHeight="120"
                       preserveRatio="true">
                <image>
                    <Image url="@assets/logo.png"/>
                </image>
            </ImageView>
        </StackPane>
    </VBox>

</HBox>