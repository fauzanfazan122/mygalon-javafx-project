<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>


<!--font-->
<?import org.kordamp.ikonli.javafx.FontIcon?>

<?import javafx.scene.control.ScrollPane?>
<BorderPane xmlns:fx="http://javafx.com/fxml"
            prefWidth="1000"
            prefHeight="650"
            stylesheets="@style.css"
            styleClass="dashboard-root"
            fx:controller="com.fauzan.mygalon.controller.DashboardController">

    <!-- HEADER -->
    <top>
        <HBox spacing="10"
              styleClass="topbar">
            <HBox prefWidth="220"
                  maxWidth="220"
                  styleClass="topbar-left"
                  alignment="CENTER">
                <Label text="MyGalon"
                       graphicTextGap="8"
                       styleClass="brand-text">
                    <graphic>
                        <StackPane prefWidth="32"
                                   prefHeight="32"
                                   maxWidth="32"
                                   maxHeight="32"
                                   styleClass="logo">

                            <ImageView fitWidth="32"
                                       fitHeight="32"
                                       preserveRatio="true">

                                <image>
                                    <Image url="@assets/logo.png"/>
                                </image>

                            </ImageView>

                        </StackPane>
                    </graphic>
                </Label>
            </HBox>
            <HBox styleClass="topbar-right"
                  HBox.hgrow="ALWAYS">
                <Label text="Dashboard"
                        styleClass="page-title"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button styleClass="btn-logout">
                    <text>Logout</text>
                    <graphic>
                        <FontIcon iconLiteral="fas-sign-out-alt" iconColor="white"/>
                    </graphic>
                </Button>
            </HBox>
        </HBox>
    </top>

    <!-- SIDEBAR -->
    <left>
        <VBox spacing="10"
              prefWidth="220"
              styleClass="sidebar">

            <Button text="Dashboard"
                    maxWidth="Infinity"
                    styleClass="sidebar-button"/>

            <Button text="Transaksi"
                    onAction="#bukaTransaksi"
                    maxWidth="Infinity"
                    styleClass="sidebar-button"/>

            <Button text="Laporan"
                    maxWidth="Infinity"
                    styleClass="sidebar-button"/>

        </VBox>
    </left>

    <!-- CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="content-scroll">
            <content>
                <VBox spacing="20"
                      styleClass="content">

                    <HBox>
                        <Label text="Selamat datang "
                               styleClass="hello-title"/>
                        <Label fx:id="usernameLabel"
                               styleClass="hello-title"/>
                    </HBox>

                    <!-- CARD -->
                    <HBox spacing="16">

                        <VBox spacing="8"
                              prefWidth="180"
                              styleClass="dashboard-card">

                            <Label text="Transaksi hari ini"
                                   styleClass="card-title"/>

                            <Label fx:id="jumlahTransaksiLabel"
                                   styleClass="card-value"/>

                        </VBox>

                        <VBox spacing="8"
                              prefWidth="200"
                              styleClass="dashboard-card">

                            <Label text="Perlu diantar"
                                   styleClass="card-title"/>

                            <Label fx:id="pengantaranLabel"
                                   styleClass="card-value"/>

                        </VBox>

                        <VBox spacing="8"
                              prefWidth="200"
                              styleClass="dashboard-card">

                            <Label text="Pendapatan"
                                   styleClass="card-title"/>

                            <Label fx:id="pendapatanLabel"
                                   styleClass="card-value"/>

                        </VBox>
                    </HBox>

                    <!-- tambah transaksi -->
                    <Button prefWidth="180"
                            graphicTextGap="8"
                            styleClass="btn-input"
                            onAction="#bukaTransaksi">
                        <text>Tambah Transaksi</text>
                        <graphic>
                            <FontIcon iconLiteral="fas-plus" iconColor="white"/>
                        </graphic>
                    </Button>

                    <TableView fx:id="tableTransaksi"
                               prefHeight="400"
                               prefWidth="800">

                        <columns>

                            <TableColumn fx:id="colNum"
                                         text="No"
                                         prefWidth="50"/>

                            <TableColumn fx:id="colNama"
                                         text="Nama"
                                         prefWidth="100"/>

                            <TableColumn fx:id="colJumlah"
                                         text="Jumlah Galon"
                                         prefWidth="50"/>

                            <TableColumn fx:id="colKurir"
                                         text="Kurir"
                                         prefWidth="100"/>

                            <TableColumn fx:id="colMetode"
                                         text="Metode"
                                         prefWidth="100"/>

                            <TableColumn fx:id="colAlamat"
                                         text="Alamat"
                                         prefWidth="100"/>

                            <TableColumn fx:id="colTanggal"
                                         text="Tanggal"
                                         prefWidth="100"/>

                            <TableColumn fx:id="colTotal"
                                         text="Total"
                                         prefWidth="100"/>

                            <TableColumn fx:id="colStatus"
                                         text="Status"
                                         prefWidth="100"/>
                        </columns>
                    </TableView>
                </VBox>
            </content>
        </ScrollPane>


    </center>

</BorderPane>