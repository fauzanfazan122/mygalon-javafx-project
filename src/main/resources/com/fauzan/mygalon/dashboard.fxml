<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>


<!--font-->
<?import org.kordamp.ikonli.javafx.FontIcon?>

<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import java.lang.String?>
<BorderPane xmlns:fx="http://javafx.com/fxml"
            prefWidth="1000"
            prefHeight="650"
            stylesheets="@style.css"
            styleClass="dashboard-root"
            fx:controller="com.fauzan.mygalon.controller.DashboardController">

    <!-- HEADER -->
    <top>
        <HBox spacing="10"
              styleClass="topbar">
            <HBox prefWidth="220"
                  maxWidth="220"
                  styleClass="topbar-left"
                  alignment="CENTER">
                <Label text="MyGalon"
                       graphicTextGap="8"
                       styleClass="brand-text">
                    <graphic>
                        <StackPane prefWidth="32"
                                   prefHeight="32"
                                   maxWidth="32"
                                   maxHeight="32"
                                   styleClass="logo">

                            <ImageView fitWidth="32"
                                       fitHeight="32"
                                       preserveRatio="true">

                                <image>
                                    <Image url="@assets/logo.png"/>
                                </image>

                            </ImageView>

                        </StackPane>
                    </graphic>
                </Label>
            </HBox>
            <HBox styleClass="topbar-right"
                  HBox.hgrow="ALWAYS">
                <Label text="Dashboard"
                        styleClass="page-title"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button onAction="#keluar"
                        styleClass="btn-logout">
                    <text>Logout</text>
                    <graphic>
                        <FontIcon iconLiteral="fas-sign-out-alt" iconColor="white"/>
                    </graphic>
                </Button>
            </HBox>
        </HBox>
    </top>

    <!-- SIDEBAR -->
    <left>
        <VBox spacing="10"
              prefWidth="220"
              styleClass="sidebar">

            <Button text="Dashboard"
                    maxWidth="Infinity">
                <styleClass>
                    <String fx:value="sidebar-button"/>
                    <String fx:value="active"/>
                </styleClass>
            </Button>

            <Button text="Transaksi"
                    onAction="#bukaTransaksi"
                    maxWidth="Infinity"
                    styleClass="sidebar-button"/>

            <Button text="Setting Harga"
                    maxWidth="Infinity"
                    onAction="#bukaHarga"
                    styleClass="sidebar-button"/>

            <Button text="Laporan"
                    maxWidth="Infinity"
                    styleClass="sidebar-button"/>

        </VBox>
    </left>

    <!-- CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="content-scroll">
            <content>
                <VBox spacing="20"
                      styleClass="content">

                    <HBox>
                        <Label text="Selamat datang "
                               styleClass="hello-title"/>
                        <Label fx:id="usernameLabel"
                               styleClass="hello-title"/>
                    </HBox>

                    <!-- CARD -->
                    <HBox spacing="16">

                        <VBox spacing="8"
                              prefWidth="180"
                              styleClass="dashboard-card">

                            <Label text="Transaksi hari ini"
                                   styleClass="card-title"/>

                            <Label fx:id="jumlahTransaksiLabel"
                                   styleClass="card-value"/>

                        </VBox>

                        <VBox spacing="8"
                              prefWidth="200"
                              styleClass="dashboard-card">

                            <Label text="Perlu diantar"
                                   styleClass="card-title"/>

                            <Label fx:id="pengantaranLabel"
                                   styleClass="card-value"/>

                        </VBox>

                        <VBox spacing="8"
                              prefWidth="200"
                              styleClass="dashboard-card">

                            <Label text="Pendapatan"
                                   styleClass="card-title"/>

                            <Label fx:id="pendapatanLabel"
                                   styleClass="card-value"/>

                        </VBox>
                    </HBox>

                    <HBox spacing="16">

                        <!-- tambah transaksi -->
                        <Button prefWidth="180"
                                graphicTextGap="8"
                                styleClass="btn-tambah"
                                onAction="#bukaTransaksi">
                            <text>Tambah Transaksi</text>
                            <graphic>
                                <FontIcon iconLiteral="fas-plus" iconColor="white"/>
                            </graphic>
                        </Button>

                        <!-- edit harga -->
                        <Button prefWidth="180"
                                graphicTextGap="8"
                                styleClass="btn-edit"
                                onAction="#bukaHarga">
                            <text>Edit Harga</text>
                            <graphic>
                                <FontIcon iconLiteral="fas-edit" iconColor="white"/>
                            </graphic>
                        </Button>
                    </HBox>

                    <VBox styleClass="dashboard-card">
                        <LineChart fx:id="lineChart" title="Transaksi Mingguan">
                            <xAxis>
                                <CategoryAxis/>
                            </xAxis>

                            <yAxis>
                                <NumberAxis label="Jumlah" />
                            </yAxis>
                        </LineChart>
                    </VBox>

                    <!-- TABLE -->
                    <VBox spacing="10"
                          styleClass="card"
                          VBox.vgrow="ALWAYS">

                        <Label text="Data Transaksi Terbaru"
                               style="-fx-text-fill: #000;"/>

                        <TableView fx:id="tableTransaksi"
                                   prefHeight="400"
                                   prefWidth="800">

                            <columns>

                                <TableColumn fx:id="colNum"
                                             text="No"
                                             prefWidth="30"/>

                                <TableColumn fx:id="colNama"
                                             text="Nama"
                                             prefWidth="80"/>

                                <TableColumn fx:id="colJumlah"
                                             text="Jumlah"
                                             prefWidth="50"/>

                                <TableColumn fx:id="colTanggal"
                                             text="Tanggal"
                                             prefWidth="100"/>

                                <TableColumn fx:id="colTotal"
                                             text="Total"
                                             prefWidth="100"/>

                                <TableColumn fx:id="colStatus"
                                             text="Status"
                                             prefWidth="80"/>
                            </columns>
                        </TableView>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>


    </center>

</BorderPane>