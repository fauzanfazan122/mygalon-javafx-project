<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.control.TextField?>


<!--font-->
<?import org.kordamp.ikonli.javafx.FontIcon?>

<?import javafx.scene.control.ScrollPane?>
<?import java.lang.String?>
<BorderPane xmlns:fx="http://javafx.com/fxml"
            prefWidth="1000"
            prefHeight="650"
            stylesheets="@style.css"
            styleClass="dashboard-root"
            fx:controller="com.fauzan.mygalon.controller.HargaController">

    <!-- HEADER -->
    <top>
        <HBox spacing="10"
              styleClass="topbar">
            <HBox prefWidth="220"
                  maxWidth="220"
                  styleClass="topbar-left"
                  alignment="CENTER">
                <Label text="MyGalon"
                       graphicTextGap="8"
                       styleClass="brand-text">
                    <graphic>
                        <StackPane prefWidth="32"
                                   prefHeight="32"
                                   maxWidth="32"
                                   maxHeight="32"
                                   styleClass="logo">

                            <ImageView fitWidth="32"
                                       fitHeight="32"
                                       preserveRatio="true">

                                <image>
                                    <Image url="@assets/logo.png"/>
                                </image>

                            </ImageView>

                        </StackPane>
                    </graphic>
                </Label>
            </HBox>
            <HBox styleClass="topbar-right"
                  HBox.hgrow="ALWAYS">
                <Label text="Setting Harga"
                       styleClass="page-title"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button styleClass="btn-logout">
                    <text>Logout</text>
                    <graphic>
                        <FontIcon iconLiteral="fas-sign-out-alt" iconColor="white"/>
                    </graphic>
                </Button>
            </HBox>
        </HBox>
    </top>

    <!-- SIDEBAR -->
    <left>
        <VBox spacing="10"
              prefWidth="220"
              styleClass="sidebar">

            <Button text="Dashboard"
                    onAction="#bukaDashboard"
                    maxWidth="Infinity"
                    styleClass="sidebar-button"/>

            <Button text="Transaksi"
                    maxWidth="Infinity"
                    onAction="#bukaTransaksi"
                    styleClass="sidebar-button"/>

            <Button text="Setting Harga"
                    maxWidth="Infinity"
                    styleClass="sidebar-button">
                <styleClass>
                    <String fx:value="sidebar-button"/>
                    <String fx:value="active"/>
                </styleClass>
            </Button>

            <Button text="Laporan"
                    maxWidth="Infinity"
                    styleClass="sidebar-button"/>

        </VBox>
    </left>


    <center>

        <ScrollPane fitToWidth="true" styleClass="content-scroll">
            <content>
                <VBox spacing="20"
                      styleClass="content">

                    <!-- CARD -->
                    <HBox spacing="16">

                        <VBox spacing="8"
                              prefWidth="200"
                              styleClass="dashboard-card">

                            <Label text="Harga Galon"
                                   styleClass="card-title"/>

                            <Label fx:id="hargaGalonLabel"
                                   styleClass="card-value"/>

                        </VBox>

                        <VBox spacing="8"
                              prefWidth="200"
                              styleClass="dashboard-card">

                            <Label text="Harga Kirim"
                                   styleClass="card-title"/>

                            <Label fx:id="hargaKirimLabel"
                                   styleClass="card-value"/>

                        </VBox>
                    </HBox>

                    <!-- FORM -->
                    <VBox spacing="20"
                          prefWidth="900"
                          styleClass="form-card">

                        <Label styleClass="form-label" text="Update Harga"/>

                        <!-- ROW 1 -->
                        <HBox spacing="15">

                            <!-- Harga galon -->
                            <VBox spacing="8"
                                  HBox.hgrow="ALWAYS">

                                <Label styleClass="form-label" text="Harga Galon"/>

                                <TextField fx:id="inputHargaGalon"
                                           styleClass="form-input"
                                           prefWidth="300"
                                           maxWidth="Infinity"/>

                            </VBox>

                            <!-- Harga kirim -->
                            <VBox spacing="8"
                                  HBox.hgrow="ALWAYS">

                                <Label styleClass="form-label" text="Harga Kirim"/>

                                <TextField fx:id="inputHargaKirim"
                                           prefWidth="300"
                                           maxWidth="Infinity"
                                           styleClass="form-input"/>

                            </VBox>

                        </HBox>

                        <!-- BUTTON -->
                        <HBox spacing="10">

                            <Button text="Perbarui"
                                    styleClass="btn-primary"
                                    onAction="#updateTransaksi"/>

                            <Button styleClass="btn-secondary"
                                    text="Reset"
                                    onAction="#resetInput"/>

                        </HBox>

                        <!-- Status -->
                        <VBox HBox.hgrow="ALWAYS">
                            <Label managed="false" visible="false" fx:id="statusLabel" />
                        </VBox>
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>

    </center>

</BorderPane>