<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>


<!--font-->
<?import org.kordamp.ikonli.javafx.FontIcon?>

<?import javafx.scene.control.ScrollPane?>
<BorderPane xmlns:fx="http://javafx.com/fxml"
            prefWidth="1000"
            prefHeight="650"
            stylesheets="@style.css"
            styleClass="dashboard-root"
            fx:controller="com.fauzan.mygalon.controller.TransaksiController">

    <!-- HEADER -->
    <top>
        <HBox spacing="10"
              styleClass="topbar">
            <HBox prefWidth="220"
                  maxWidth="220"
                  styleClass="topbar-left"
                  alignment="CENTER">
                <Label text="MyGalon"
                       graphicTextGap="8"
                       styleClass="brand-text">
                    <graphic>
                        <StackPane prefWidth="32"
                                   prefHeight="32"
                                   maxWidth="32"
                                   maxHeight="32"
                                   styleClass="logo">

                            <ImageView fitWidth="32"
                                       fitHeight="32"
                                       preserveRatio="true">

                                <image>
                                    <Image url="@assets/logo.png"/>
                                </image>

                            </ImageView>

                        </StackPane>
                    </graphic>
                </Label>
            </HBox>
            <HBox styleClass="topbar-right"
                  HBox.hgrow="ALWAYS">
                <Label text="Transaksi"
                       styleClass="page-title"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button styleClass="btn-logout">
                    <text>Logout</text>
                    <graphic>
                        <FontIcon iconLiteral="fas-sign-out-alt" iconColor="white"/>
                    </graphic>
                </Button>
            </HBox>
        </HBox>
    </top>

    <!-- SIDEBAR -->
    <left>
        <VBox spacing="10"
              prefWidth="220"
              styleClass="sidebar">

            <Button text="Dashboard"
                    onAction="#bukaDashboard"
                    maxWidth="Infinity"
                    styleClass="sidebar-button"/>

            <Button text="Transaksi"
                    maxWidth="Infinity"
                    styleClass="sidebar-button"/>

            <Button text="Laporan"
                    maxWidth="Infinity"
                    styleClass="sidebar-button"/>

        </VBox>
    </left>


    <center>

        <ScrollPane fitToWidth="true" styleClass="content-scroll">
            <content>
                <VBox spacing="20"
                      styleClass="content">

                    <!-- FORM -->
                    <VBox spacing="20"
                          prefWidth="900"
                          styleClass="dashboard-card">

                        <Label text="Tambah Transaksi"/>

                        <!-- ROW 1 -->
                        <HBox spacing="15">

                            <!-- Nama -->
                            <VBox spacing="8"
                                  HBox.hgrow="ALWAYS">

                                <Label text="Nama Pembeli"/>

                                <TextField fx:id="inputNama"
                                           styleClass="form-input"
                                           promptText="Masukkan nama pembeli"
                                           prefWidth="300"
                                           maxWidth="Infinity"/>

                            </VBox>

                            <!-- Jumlah Galon -->
                            <VBox spacing="8"
                                  HBox.hgrow="ALWAYS">

                                <Label text="Jumlah Galon"/>

                                <TextField fx:id="inputJumlahGalon"
                                           promptText="Masukkan jumlah galon"
                                           prefWidth="300"
                                           maxWidth="Infinity"
                                           styleClass="form-input"/>

                            </VBox>

                        </HBox>

                        <!-- ROW 2 -->
                        <HBox spacing="15">

                            <!-- Nama Kurir -->
                            <VBox spacing="8"
                                  HBox.hgrow="ALWAYS">

                                <Label text="Nama Kurir"/>

                                <TextField fx:id="inputKurir"
                                           promptText="Masukkan nama kurir"
                                           prefWidth="300"
                                           styleClass="form-input"
                                           maxWidth="Infinity"/>

                            </VBox>

                            <!-- Metode -->
                            <VBox spacing="8"
                                  HBox.hgrow="ALWAYS">

                                <Label text="Metode Pengiriman"/>

                                <ComboBox fx:id="inputMetode"
                                          promptText="Pilih metode"
                                          prefWidth="300"
                                          styleClass="form-input"
                                          maxWidth="Infinity"/>

                            </VBox>

                        </HBox>

                        <!-- ROW 3 -->
                        <VBox spacing="8">

                            <Label text="Alamat Pengantaran"/>

                            <TextArea fx:id="inputAlamat"
                                      promptText="Masukkan alamat pengantaran"
                                      prefRowCount="3"
                                      prefWidth="600"
                                      maxWidth="Infinity"/>

                        </VBox>

                        <!-- ROW 4 -->
                        <HBox spacing="15">

                            <!-- Status -->
                            <VBox spacing="8"
                                  HBox.hgrow="ALWAYS">

                                <Label text="Status Transaksi"/>

                                <ComboBox fx:id="inputStatus"
                                          promptText="Pilih status"
                                          prefWidth="300"
                                          maxWidth="Infinity"/>

                            </VBox>

                            <!-- Total -->
                            <VBox spacing="8"
                                  HBox.hgrow="ALWAYS">

                                <Label text="Total Transaksi"/>

                                <Label fx:id="totalLabel"
                                       text="Rp 0"
                                       prefWidth="300"/>

                            </VBox>

                        </HBox>

                        <!-- BUTTON -->
                        <HBox spacing="10">

                            <Button fx:id="kirimButton"
                                    styleClass="btn-primary"
                                    onAction="#kirimTransaksi"/>

                            <Button fx:id="subButton"
                                    styleClass="btn-secondary"
                                    onAction="#cancelButton"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Button fx:id="hapusButton"
                                    text="Hapus"
                                    managed="false"
                                    visible="false"
                                    styleClass="btn-danger"
                                    onAction="#deleteTransaksi"/>

                        </HBox>


                        <!-- Status -->
                        <VBox HBox.hgrow="ALWAYS">
                            <Label styleClass="status-error" managed="false" visible="false" fx:id="labelStatus" />
                        </VBox>

                    </VBox>

                    <!-- TABLE -->
                    <VBox spacing="10"
                          styleClass="card"
                          VBox.vgrow="ALWAYS">

                        <Label text="Data Transaksi"
                               styleClass="section-title"/>

                        <TableView fx:id="tableTransaksi"
                                   prefHeight="400"
                                   prefWidth="800">

                            <columns>

                                <TableColumn fx:id="colNum"
                                             text="No"
                                             prefWidth="50"/>

                                <TableColumn fx:id="colNama"
                                             text="Nama"
                                             prefWidth="100"/>

                                <TableColumn fx:id="colJumlah"
                                             text="Jumlah Galon"
                                             prefWidth="50"/>

                                <TableColumn fx:id="colKurir"
                                             text="Kurir"
                                             prefWidth="100"/>

                                <TableColumn fx:id="colMetode"
                                             text="Metode"
                                             prefWidth="100"/>

                                <TableColumn fx:id="colAlamat"
                                             text="Alamat"
                                             prefWidth="100"/>

                                <TableColumn fx:id="colTanggal"
                                             text="Tanggal"
                                             prefWidth="100"/>

                                <TableColumn fx:id="colTotal"
                                             text="Total"
                                             prefWidth="100"/>

                                <TableColumn fx:id="colStatus"
                                             text="Status"
                                             prefWidth="100"/>

                            </columns>

                        </TableView>

                    </VBox>

                </VBox>
            </content>
        </ScrollPane>

    </center>

</BorderPane>