<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>


<!--icon-->
<?import org.kordamp.ikonli.javafx.FontIcon?>

<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import java.lang.String?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<BorderPane xmlns:fx="http://javafx.com/fxml"
            prefWidth="1000"
            prefHeight="650"
            stylesheets="@style.css"
            styleClass="dashboard-root"
            fx:controller="com.fauzan.mygalon.controller.LaporanController">

    <!-- HEADER -->
    <top>
        <HBox spacing="10"
              styleClass="topbar">
            <HBox prefWidth="220"
                  maxWidth="220"
                  styleClass="topbar-left"
                  alignment="CENTER">
                <Label text="MyGalon"
                       graphicTextGap="8"
                       styleClass="brand-text">
                    <graphic>
                        <StackPane prefWidth="32"
                                   prefHeight="32"
                                   maxWidth="32"
                                   maxHeight="32"
                                   styleClass="logo">

                            <ImageView fitWidth="32"
                                       fitHeight="32"
                                       preserveRatio="true">

                                <image>
                                    <Image url="@assets/logo.png"/>
                                </image>

                            </ImageView>

                        </StackPane>
                    </graphic>
                </Label>
            </HBox>
            <HBox styleClass="topbar-right"
                  HBox.hgrow="ALWAYS">
                <Label text="Laporan"
                        styleClass="page-title"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button styleClass="btn-logout">
                    <text>Logout</text>
                    <graphic>
                        <FontIcon iconLiteral="fas-sign-out-alt" iconColor="white"/>
                    </graphic>
                </Button>
            </HBox>
        </HBox>
    </top>

    <!-- SIDEBAR -->
    <left>
        <VBox spacing="10"
              prefWidth="220"
              styleClass="sidebar">

            <Button text="Dashboard"
                    onAction="#bukaDashboard"
                    styleClass="sidebar-button"
                    maxWidth="Infinity">
            </Button>

            <Button text="Transaksi"
                    onAction="#bukaTransaksi"
                    maxWidth="Infinity"
                    styleClass="sidebar-button"/>

            <Button text="Setting Harga"
                    maxWidth="Infinity"
                    onAction="#bukaHarga"
                    styleClass="sidebar-button"/>

            <Button text="Laporan"
                    maxWidth="Infinity"
                    styleClass="sidebar-button">
                <styleClass>
                    <String fx:value="sidebar-button"/>
                    <String fx:value="active"/>
                </styleClass>
            </Button>

            <Region VBox.vgrow="ALWAYS"/>

            <HBox alignment="CENTER">
                <Label style="-fx-font-size: 11; -fx-text-fill: #555" text="© Copyright RM.Fauzan 162024035" />
            </HBox>

        </VBox>
    </left>

    <!-- CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="content-scroll">
            <content>
                <VBox spacing="24"
                      styleClass="content">

                    <VBox spacing="16">
                        <HBox alignment="CENTER">
                            <!-- section title -->
                            <Label text="Rekap Bisnis"
                                   styleClass="section-title"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <!-- filter -->
                            <HBox prefWidth="130"
                                  maxWidth="130"
                                  styleClass="filter-box"
                                  alignment="CENTER">
                                <Label prefWidth="14" maxWidth="14">
                                    <graphic>
                                        <FontIcon iconLiteral="fas-filter" iconColor="2563eb" iconSize="14"/>
                                    </graphic>
                                </Label>
                                <ComboBox fx:id="globalFilter"
                                          styleClass="filter-input"
                                          prefWidth="110"/>
                            </HBox>
                        </HBox>

                        <!-- CARD -->
                        <HBox spacing="16">

                            <VBox spacing="8"
                                  prefWidth="250"
                                  styleClass="dashboard-card">

                                <Label text="Total Transaksi"
                                       styleClass="card-title"/>

                                <Label fx:id="totalTransaksiLabel"
                                       styleClass="card-value"/>

                            </VBox>

                            <VBox spacing="8"
                                  prefWidth="250"
                                  styleClass="dashboard-card">

                                <Label text="Total Galon Terjual"
                                       styleClass="card-title"/>

                                <Label fx:id="totalPenjualanLabel"
                                       styleClass="card-value"/>

                            </VBox>

                            <VBox spacing="8"
                                  prefWidth="280"
                                  styleClass="dashboard-card">

                                <Label text="Total Pendapatan"
                                       styleClass="card-title"/>

                                <Label fx:id="totalPendapatanLabel"
                                       styleClass="card-value"/>

                            </VBox>
                        </HBox>
                    </VBox>

                    <VBox spacing="16">
                        <!-- section title -->
                        <Label text="Transaksi Mingguan"
                               styleClass="section-title"/>

                        <VBox styleClass="dashboard-card">
                            <LineChart fx:id="transaksiChart">
                                <xAxis>
                                    <CategoryAxis/>
                                </xAxis>

                                <yAxis>
                                    <NumberAxis label="Jumlah" />
                                </yAxis>
                            </LineChart>
                        </VBox>
                    </VBox>

                    <VBox spacing="16">
                        <!-- section title -->
                        <Label text="Pemasukan Harian"
                               styleClass="section-title"/>

                        <VBox styleClass="dashboard-card">
                            <LineChart fx:id="pemasukanChart" >
                                <xAxis>
                                    <CategoryAxis/>
                                </xAxis>

                                <yAxis>
                                    <NumberAxis label="Jumlah" />
                                </yAxis>
                            </LineChart>
                        </VBox>
                    </VBox>

                    <!-- section 4 -->
                    <VBox spacing="16">
                        <!-- section title -->
                        <Label text="Cetak Laporan"
                               styleClass="section-title"/>

                        <!-- Filter cetak -->
                        <VBox spacing="20"
                              styleClass="form-card">

                            <VBox spacing="8">

                                <Label styleClass="form-label" text="Pilih Periode Laporan"/>

                                <HBox alignment="CENTER" spacing="12">

                                    <DatePicker fx:id="startDate"
                                                promptText="Tanggal Awal"
                                                styleClass="date-picker"/>

                                    <DatePicker fx:id="endDate"
                                                promptText="Tanggal Akhir"
                                                styleClass="date-picker"/>

                                    <Region HBox.hgrow="ALWAYS"/>

                                    <Button text="Cetak"
                                            onAction="#cetakLaporan"
                                            styleClass="btn-primary"/>

                                    <Button text="Reset"
                                            onAction="#reset"
                                            styleClass="btn-secondary"/>

                                </HBox>

                            </VBox>

                            <!-- Status -->
                            <VBox HBox.hgrow="ALWAYS">
                                <Label styleClass="status-error" managed="false" visible="false" fx:id="labelStatus" />
                            </VBox>
                        </VBox>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>


    </center>

</BorderPane>